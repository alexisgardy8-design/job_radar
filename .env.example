# Copie ce fichier en .env (local) — et mets les mêmes clés dans Vercel → Settings → Environment Variables.
# Le fichier .env est ignoré par git : il ne doit jamais être commité.

# --- Sécurité (obligatoire) ---
# Clé de signature (jetons 2FA) et de chiffrement (secrets TOTP) : 64 caractères hex → openssl rand -hex 32
SESSION_SECRET=
# Secret envoyé par Vercel Cron → openssl rand -hex 32
CRON_SECRET=
# Qui a le droit de créer un compte : e-mails ou domaines séparés par des virgules (ex. moi@gmail.com,@edu.devinci.fr), ou * pour tout le monde
ALLOWED_SIGNUP_EMAILS=

# --- Base de données (ajoutée automatiquement par l'intégration Neon sur Vercel) ---
DATABASE_URL=

# --- IA : scoring et lecture du CV (Vercel AI Gateway, 5 $ de crédit offerts chaque mois) ---
# Sur Vercel, l'authentification est automatique (OIDC). En local seulement : crée une clé AI Gateway.
AI_GATEWAY_API_KEY=
SCORING_MODEL=anthropic/claude-haiku-5.5
MAX_SCORED_PER_RUN=40

# --- Recherche web GRATUITE : Tavily, 1 000 recherches/mois sans carte bancaire → https://app.tavily.com ---
TAVILY_API_KEY=
MAX_SEARCHES_PER_RUN=8

# --- Sources gratuites facultatives ---
# https://francetravail.io → créer une application → s'abonner à « Offres d'emploi v2 »
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Envoi des offres par e-mail (SMTP) ---
# Gmail : active la validation en 2 étapes, puis crée un « mot de passe d'application » sur
# https://myaccount.google.com/apppasswords (16 caractères) et colle-le dans SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Job Radar <ton.adresse@gmail.com>
