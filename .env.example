# --- Accès au site (obligatoire) ---
# Mot de passe pour te connecter au site
APP_PASSWORD=change-moi-avec-un-long-mot-de-passe
# Secret de signature des sessions : 32+ caractères aléatoires (openssl rand -hex 32)
SESSION_SECRET=
# Secret que Vercel envoie au cron (openssl rand -hex 32)
CRON_SECRET=

# --- Base de données (ajoutée automatiquement par l'intégration Neon) ---
DATABASE_URL=

# --- IA (AI Gateway) : sur Vercel l'auth OIDC est automatique ; en local, mets une clé ---
AI_GATEWAY_API_KEY=
# Modèle de scoring (optionnel)
SCORING_MODEL=anthropic/claude-haiku-5.5

# --- Sources gratuites ---
# https://francetravail.io : crée une application, abonne-la à "Offres d'emploi v2"
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# https://developer.adzuna.com : inscription gratuite
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Notifications (au moins un des deux) ---
# E-mail via https://resend.com (gratuit jusqu'à 3 000 mails/mois)
RESEND_API_KEY=
RESEND_FROM=Job Radar <onboarding@resend.dev>
# Telegram : crée un bot avec @BotFather, colle le token ici
TELEGRAM_BOT_TOKEN=

# Nombre max d'offres notées par l'IA à chaque scan (maîtrise des coûts)
MAX_SCORED_PER_RUN=40

# Secret partagé avec le script Gmail (alertes e-mail, facultatif) : openssl rand -hex 32
INGEST_SECRET=
# Nombre max de recherches web par scan (≈ 0,005 $ chacune)
MAX_SEARCHES_PER_RUN=12
